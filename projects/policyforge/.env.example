# PolicyForge environment template
# Copy this file to .env.local and fill in the values when deploying.
# Never commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (optional; falls back to data/waitlist.jsonl if not set)
POSTGRES_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# AI / LLM
ANTHROPIC_API_KEY=

# Vercel deployment (CI/CD and CLI)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Cloudflare object storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=policyforge-packs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# GitHub CLI (for provisioning secrets)
GH_TOKEN=

# Auth (NextAuth.js) — optional until auth is wired
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
